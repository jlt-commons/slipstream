{:paths ["src" "example"]
 :deps {}

 :jolt/native [{:name "slipstream"
                :darwin ["native/libslipstream.dylib"]
                :linux ["native/libslipstream.so"]}]

 :aliases {:test {:extra-paths ["test" "example"]
                  :main-opts ["-m" "slipstream.test-runner"]}
           :parity {:extra-paths ["test" "example"]
                    :main-opts ["-m" "slipstream.parity-test"]}}

 :tasks {:requires ([babashka.fs :as fs])
         :init (def lib (str "native/libslipstream."
                             (if (re-find #"^Mac" (System/getProperty "os.name"))
                               "dylib"
                               "so")))

         native {:doc "build the Slughorn shim if its sources changed"
                 :task (let [slughorn (or (System/getenv "SLUGHORN_HOME")
                                          (str (System/getProperty "user.home") "/src/slughorn"))
                             stamp "native/build/slipstream-slughorn-home"
                             configured (when (fs/exists? stamp)
                                          (.trim (slurp stamp)))
                             sources ["native/CMakeLists.txt"
                                      "native/slipstream_shim.h"
                                      "native/slipstream_internal.hpp"
                                      "native/atlas.cpp"
                                      "native/shapes.cpp"
                                      "native/mesh.cpp"
                                      "native/path.cpp"
                                      "native/canvas.cpp"
                                      "native/freetype.cpp"
                                      "native/glfw_renderer.cpp"
                                      "native/parity_oracle.cpp"
                                      (str slughorn "/example/slughorn-example-glfw.cpp")
                                      (str slughorn "/slughorn/slughorn.cpp")
                                      (str slughorn "/slughorn/slughorn.hpp")
                                      (str slughorn "/slughorn/canvas.hpp")
                                      (str slughorn "/slughorn/freetype.hpp")
                                      (str slughorn "/slughorn/serial.hpp")
                                      "deps.edn"]]
                         (if (or (not= slughorn configured)
                                 (not (fs/exists? lib))
                                 (seq (fs/modified-since lib sources)))
                           (do
                             (shell "cmake" "-S" "native" "-B" "native/build"
                                    "-DCMAKE_BUILD_TYPE=Release"
                                    (str "-DSLUGHORN_HOME=" slughorn))
                             (shell "cmake" "--build" "native/build"
                                    "--config" "Release" "--parallel")
                             (spit stamp slughorn)
                             (println "built:" lib))
                           (println "up to date:" lib)))}

         test {:doc "unit tests"
               :depends [native]
               :task (jolt "-M:test")}

         parity {:doc "compare native data, rendered frames, and example behavior"
                 :depends [native]
                 :task (jolt "-M:parity")}}}
