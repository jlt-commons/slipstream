{:paths ["src" "example"]
 :deps {io.github.jolt-lang/glimmer
        {:git/url "https://github.com/jolt-lang/glimmer.git"
         :git/tag "v0.1.7"
         :git/sha "22350c4d047b05359a16b756b20f38ecb391a63b"}
        jolt-lang/nrepl
        {:git/url "https://github.com/jolt-lang/nrepl"
         :git/tag "v0.4.0"
         :git/sha "16558b920864e5302a5c1433a78f977bbb64a9d1"}}

 :nrepl/middleware [nrepl.middleware/default-middleware
                    cider.nrepl/cider-middleware]

 ;; :build names the task that produces the library, so a consumer pulling
 ;; slipstream as a git dep gets it built in the checkout on first use.
 :jolt/native [{:name "slipstream"
                :darwin ["native/libslipstream.dylib"]
                :linux ["native/libslipstream.so"]
                :build "native"}]

 :aliases {:dev {:override-deps
                 {io.github.jolt-lang/glimmer
                  {:local/root "../glimmer"}}}
           :test {:extra-paths ["test" "example"]
                  :main-opts ["-m" "slipstream.test-runner"]}
           :parity {:extra-paths ["test" "example"]
                    :main-opts ["-m" "slipstream.parity-test"]}}

 :tasks {:requires ([babashka.fs :as fs])
         :init (do (def lib (str "native/libslipstream."
                                 (if (re-find #"^Mac" (System/getProperty "os.name"))
                                   "dylib"
                                   "so")))
                   ;; the Slughorn commit slipstream is developed and tested against
                   (def slughorn-ref "704ef1d96751a5a5a38f3cff0f0ded4e7b6893dc")
                   (def slughorn (str (fs/absolutize (or (System/getenv "SLUGHORN_HOME")
                                                         "vendor/slughorn")))))

         slughorn {:doc "fetch the pinned Slughorn commit into vendor/slughorn (skipped when SLUGHORN_HOME is set or it is already there)"
                   :task (cond
                           (System/getenv "SLUGHORN_HOME")
                           (when-not (fs/exists? (str slughorn "/slughorn/slughorn.cpp"))
                             (throw (ex-info (str "SLUGHORN_HOME=" slughorn
                                                  " has no slughorn/slughorn.cpp; point it at a Slughorn checkout")
                                             {})))

                           (fs/exists? "vendor/slughorn/slughorn/slughorn.cpp")
                           (println "slughorn: up to date")

                           :else
                           (do (fs/create-dirs "vendor/slughorn")
                               (shell {:dir "vendor/slughorn"} "git" "init" "-q")
                               (shell {:dir "vendor/slughorn"} "git" "fetch" "-q" "--depth" "1"
                                      "https://github.com/AlphaPixel/slughorn.git" slughorn-ref)
                               (shell {:dir "vendor/slughorn"} "git" "checkout" "-q" "FETCH_HEAD")
                               ;; nlohmann/json, unless the system has it
                               (shell {:dir "vendor/slughorn"} "git" "submodule" "update"
                                      "--init" "--depth" "1" "ext/json")))}

         native {:doc "build the Slughorn shim if its sources changed"
                 :depends [slughorn]
                 :task (let [stamp "native/build/slipstream-slughorn-home"
                             configured (when (fs/exists? stamp)
                                          (.trim (slurp stamp)))
                             sources ["native/CMakeLists.txt"
                                      "native/slipstream_shim.h"
                                      "native/slipstream_internal.hpp"
                                      "native/atlas.cpp"
                                      "native/shapes.cpp"
                                      "native/mesh.cpp"
                                      "native/path.cpp"
                                      "native/canvas.cpp"
                                      "native/freetype.cpp"
                                      "native/glfw_renderer.cpp"
                                      "native/advanced_shaders.cpp"
                                      "native/paint.cpp"
                                      "native/compositor.cpp"
                                      "native/compositor.hpp"
                                      "native/reactive_renderer.cpp"
                                      "native/reactive_renderer.hpp"
                                      "native/parity_oracle.cpp"
                                      (str slughorn "/example/slughorn-example-glfw.cpp")
                                      (str slughorn "/slughorn/slughorn.cpp")
                                      (str slughorn "/slughorn/slughorn.hpp")
                                      (str slughorn "/slughorn/canvas.hpp")
                                      (str slughorn "/slughorn/freetype.hpp")
                                      (str slughorn "/slughorn/serial.hpp")]]
                         (if (or (not= slughorn configured)
                                 (not (fs/exists? lib))
                                 (seq (fs/modified-since lib sources)))
                           (do
                             (shell "cmake" "-S" "native" "-B" "native/build"
                                    "-DCMAKE_BUILD_TYPE=Release"
                                    (str "-DSLUGHORN_HOME=" slughorn))
                             (shell "cmake" "--build" "native/build"
                                    "--config" "Release" "--parallel")
                             (spit stamp slughorn)
                             (println "built:" lib))
                           (println "up to date:" lib)))}

         test {:doc "unit tests"
               :depends [native]
               :task (jolt "-M:test")}

         parity {:doc "compare native data, rendered frames, and example behavior"
                 :depends [native]
                 :task (jolt "-M:parity")}}}
